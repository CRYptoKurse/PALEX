// Пример программы на языке MiniCompiler
// Демонстрирует все категории лексем: ключевые слова, идентификаторы,
// литералы, операторы, разделители, комментарии.

fn main() {
    int answer = 42;             // целочисленный литерал
    float pi = 3.14159;          // литерал с плавающей точкой
    bool flag = true;             // булев литерал (true)
    bool another = false;         // булев литерал (false)

    // Строковый литерал (как отдельное выражение)
    "Hello, world!";

    // Операторы сравнения и логические операторы
    if (answer > 40 && flag == true) {
        /* Многострочный
           комментарий */
        return answer;
    } else {
        return 0;
    }

    // Арифметические операции
    int x = 10 + 5 * 2 - 8 / 4 % 3;
}
// Конец файла