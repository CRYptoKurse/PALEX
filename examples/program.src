fn factorial(int n) -> int {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

fn main() -> int {
    int result = 0;
    int i = 0;
    for (i = 0; i < 5; i = i + 1) {
        result = result + i;
    }
    int fact = factorial(5);
    if (fact > 0) {
        result = result + fact;
    } else {
        result = result - fact;
    }
    return result;
}