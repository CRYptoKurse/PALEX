function main: int ()
  entry:
    x_1 = ALLOCA  1  # var x
    STORE  [x_1], 1  # x = init
    t1 = LOAD  [x_1]  # load x
    t2 = CMP_LT  t1, 2  # < (type=bool)
    JUMP_IF  t2, L_then_1  # if true
    JUMP  L_else_2  # if false
  L_then_1:
    t3 = LOAD  [x_1]  # load x
    t4 = ADD  t3, 1  # + (type=int)
    STORE  [x_1], t4  # x =
    t5 = MOVE  t4  # assignment result (type=int)
    JUMP  L_endif_3
  L_else_2:
    t6 = LOAD  [x_1]  # load x
    t7 = SUB  t6, 1  # - (type=int)
    STORE  [x_1], t7  # x =
    t8 = MOVE  t7  # assignment result (type=int)
    JUMP  L_endif_3
  L_endif_3:
    t9 = PHI  (t5, L_then_1), (t8, L_else_2)  # phi x
    STORE  [x_1], t9  # x = phi
    t10 = LOAD  [x_1]  # load x
    RETURN  t10
